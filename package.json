{
  "name": "slide-ng-vscode",
  "displayName": "slide.ng",
  "description": "Syntax, outline, dev server and preview for slide.ng decks (slides.md)",
  "version": "0.1.0",
  "publisher": "slide-ng",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/slide-ng/slide.ng-vscode"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test test/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package": "npm run build && vsce package --no-dependencies --out slide.ng-vscode.vsix"
  },
  "devDependencies": {
    "@slidev/parser": "^53.0.0",
    "@types/node": "^22.20.5",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tm-grammars": "^1.32.22",
    "typescript": "^7.0.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
